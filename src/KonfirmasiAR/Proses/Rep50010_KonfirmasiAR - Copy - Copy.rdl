                                </TextRun>
                                <TextRun>
                                  <Value>=FormatDateTime(First(Fields!PositionDate.Value, "DataSet_Result"),DateFormat.Shortdate)</Value>
                                  <Style>
                                    <Format>dd MMMM yyyy</Format>
